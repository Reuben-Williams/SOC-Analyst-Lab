| makeresults count=15 | streamstats count as n | eval scenario=case(n<=5,"SYNTHETIC-review-outbound-4444",n<=10,"SYNTHETIC-baseline-outbound-443",true(),"SYNTHETIC-inbound-control"), initiated=if(n>10,"false","true"), protocol="tcp", destination_port=if(n>5 AND n<=10,443,4444), destination="TEST-DESTINATION", agent="TEST-HOST", _time=1788333600 | where initiated="true" AND protocol="tcp" | bin _time span=5m | stats count as connections by _time scenario agent destination destination_port | eval expected=if(scenario="SYNTHETIC-review-outbound-4444",1,0), actual=if(connections>=5 AND NOT in(destination_port,53,80,443),1,0), result=if(expected=actual,"PASS","FAIL") | table scenario connections expected actual result
