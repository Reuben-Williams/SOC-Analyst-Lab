| makeresults count=21 | streamstats count as n | eval scenario=case(n<=10,"SYNTHETIC-positive-10",n<=19,"SYNTHETIC-negative-9",true(),"SYNTHETIC-success-control"), EventCode=if(n>19,4624,4625), TargetUserName=scenario, TargetDomainName="TEST", Computer="TEST-HOST", IpAddress="192.0.2.10", _time=1788333600 | search EventCode=4625 | where isnotnull(TargetUserName) AND isnotnull(IpAddress) AND IpAddress!="-" AND IpAddress!="" | eval lab_account=coalesce(TargetDomainName,"UNKNOWN")."/".TargetUserName | bin _time span=5m | stats count as failures by _time Computer lab_account IpAddress | eval expected=if(like(lab_account,"%positive-10"),1,0), actual=if(failures>=10,1,0), result=if(expected=actual,"PASS","FAIL") | table lab_account failures expected actual result
