| makeresults count=4 | streamstats count as n | eval scenario="SYNTHETIC-".n, image=if(n=4,"cmd.exe","powershell.exe"), command=case(n=1,"powershell.exe -enc TEST-NOT-EXECUTED",n=2,"powershell.exe -EncodedCommand TEST-NOT-EXECUTED",n=3,"powershell.exe -NoProfile",n=4,"cmd.exe -enc TEST-NOT-EXECUTED"), expected=if(n<=2,1,0) | eval actual=if((like(lower(image),"%powershell.exe") OR like(lower(image),"%pwsh.exe")) AND match(command,"(?i)(^|\\s)-(enc|encodedcommand)(\\s|$)"),1,0) | eval result=if(expected=actual,"PASS","FAIL") | table scenario expected actual result
