| makeresults count=4 | streamstats count as n | eval scenario="SYNTHETIC-".n, index="wazuh", sourcetype="wazuh:alert:json", agent="WIN-ENDPOINT", eventID=1, provider="Microsoft-Windows-Sysmon", image=if(n=4,"C:\\Windows\\cmd.exe","C:\\Windows\\powershell.exe"), command=case(n=1,"powershell.exe -enc TEST",n=2,"powershell.exe -encodedcommand TEST",n=3,"powershell.exe -NoProfile",n=4,"cmd.exe -enc TEST") | rename agent as agent.name eventID as data.win.system.eventID provider as data.win.system.providerName image as data.win.eventdata.image command as data.win.eventdata.commandLine | search data.win.system.eventID=1 data.win.system.providerName="Microsoft-Windows-Sysmon" index="wazuh" sourcetype="wazuh:alert:json" agent.name="WIN-ENDPOINT" data.win.eventdata.image IN ("*\\powershell.exe", "*\\pwsh.exe") data.win.eventdata.commandLine IN ("* -enc *", "* -encodedcommand *") | table scenario
